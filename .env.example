# chacha-jarvis 환경변수 템플릿
#
#   cp .env.example .env   후 값을 채운다.
#   .env 는 .gitignore 로 추적 제외된다 — 절대 커밋하지 않는다.
#
#   비밀번호 생성 예:
#     python3 -c "import secrets; print(secrets.token_urlsafe(18).replace('-','_'))"

# ── PostgreSQL (postgres 컨테이너 + spring-server 가 함께 참조) ──────────────
# 첫 기동 때 DB 에 굳는다. 이미 기동한 뒤 바꾸면 spring-server 가 인증 실패로 뜨지 않는다.
DB_USER=chacha
DB_PASS=<생성하세요>
DB_NAME=chacha_db

# ── EMQX 대시보드 (http://localhost:18083) ─────────────────────────────────
# 기본값 admin/public 은 공식 문서에 공개된 값이라 그대로 쓰지 않는다.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASS=<생성하세요>

# ── 외부 API 키 (go_fiber_server 날씨 연동) ────────────────────────────────
OPEN_WEATHER_MAP_KEY=<본인 키>
