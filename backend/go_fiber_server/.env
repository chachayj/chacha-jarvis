# -------------------------
# MQTT Broker Info
# -------------------------
MQTT_BROKER_ADDRESS=emqx      # 도커 네트워크 내부 이름
MQTT_PORT=8883                # EMQX TLS 포트

# -------------------------
# TLS Certificate Paths (컨테이너 내부 경로)
# /app/certs 폴더에 mount됨
# -------------------------
CA_CERT=/certs/cacert.pem
CLIENT_CERT=/certs/cert.pem
CLIENT_KEY=/certs/key.pem

# -------------------------
# Optional: App ENV
# -------------------------
# GO_ENV=development
# FIBER_ENV=local

OPEN_WEATHER_MAP_KEY=open_weather_map_key