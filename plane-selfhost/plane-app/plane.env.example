# chacha-jarvis 전용 Plane 인스턴스 설정 템플릿 — 공식 도커 이미지 v1.4.2
#
#   사용법:
#     cp plane.env.example plane.env
#     그다음 아래 <생성하세요> 자리를 채운다 (생성 명령은 파일 끝 주석 참고).
#
#   실제 plane.env 는 시크릿을 담으므로 .gitignore 로 추적 제외되어 있다.
#   이 파일만 커밋한다.
#
#   접속: http://localhost:8082
#   LAN 에서 붙일 때는 APP_DOMAIN 을 Windows 호스트 IP:8082 로 바꾼다.
APP_DOMAIN=localhost:8082
APP_RELEASE=v1.4.2

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# 8080 은 voice-assistant, 8081 은 spring-server, 8443 은 nginx 가 이미 쓴다.
# Plane 은 8082 / 4430 을 쓴다. (proxy 컨테이너 내부는 그대로 80/443)
LISTEN_HTTP_PORT=8082
LISTEN_HTTPS_PORT=4430

WEB_URL=http://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
API_BASE_URL=http://api:8000

#DB SETTINGS
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=<생성하세요>
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# REDIS SETTINGS
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=<생성하세요>
RABBITMQ_VHOST=plane
AMQP_URL=

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Secret Key
SECRET_KEY=<생성하세요>

# DATA STORE SETTINGS
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=<생성하세요>
AWS_SECRET_ACCESS_KEY=<생성하세요>
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Gunicorn Workers
GUNICORN_WORKERS=1

# UNCOMMENT `DOCKER_PLATFORM` IF YOU ARE ON `ARM64` AND DOCKER IMAGE IS NOT AVAILABLE FOR RESPECTIVE `APP_RELEASE`
# DOCKER_PLATFORM=linux/amd64

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT=60/minute

# Live server environment variables
# WARNING: You must set a secure value for LIVE_SERVER_SECRET_KEY in production environments.
LIVE_SERVER_SECRET_KEY=<생성하세요>

# 공식 레지스트리에서 이미지를 그대로 받아 쓴다 (소스 빌드 아님)
DOCKERHUB_USER=artifacts.plane.so/makeplane
PULL_POLICY=if_not_present
CUSTOM_BUILD=false

# ─────────────────────────────────────────────────────────────────────────────
# 시크릿 생성 예시
#
#   python3 -c "
#   import secrets, string
#   al = string.ascii_lowercase + string.digits
#   print('SECRET_KEY            =', ''.join(secrets.choice(al) for _ in range(50)))
#   print('LIVE_SERVER_SECRET_KEY=', ''.join(secrets.choice(al) for _ in range(50)))
#   print('POSTGRES_PASSWORD     =', secrets.token_urlsafe(18).replace('-','_'))
#   print('RABBITMQ_PASSWORD     =', secrets.token_urlsafe(18).replace('-','_'))
#   print('AWS_ACCESS_KEY_ID     =', secrets.token_hex(10))
#   print('AWS_SECRET_ACCESS_KEY =', secrets.token_urlsafe(24).replace('-','_'))
#   "
#
# POSTGRES_PASSWORD 는 첫 기동 때 DB 에 굳는다. 이미 기동한 뒤에 바꾸면
# api 컨테이너가 인증 실패로 뜨지 않는다 — 데이터를 버리고 다시 만들어야 한다.
# ─────────────────────────────────────────────────────────────────────────────
